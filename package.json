{
  "name": "widget-games",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @widget-games/doodle-phone dev",
    "dev:sketch": "pnpm --filter @widget-games/sketch-guess dev",
    "build": "pnpm --filter @widget-games/widget-shared typecheck && pnpm --filter @widget-games/doodle-phone build && pnpm --filter @widget-games/sketch-guess build",
    "test": "pnpm --filter @widget-games/doodle-phone test && pnpm --filter @widget-games/sketch-guess test",
    "lint": "oxlint packages",
    "fmt": "oxfmt packages package.json pnpm-workspace.yaml README.md",
    "fmt:check": "oxfmt --check packages package.json pnpm-workspace.yaml README.md"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "packageManager": "pnpm@9.14.4"
}
