{
  "name": "matrix-widgets",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm -r --parallel --if-present dev",
    "dev:doodle": "pnpm --filter @matrix-widgets/doodle-phone dev",
    "dev:sketch": "pnpm --filter @matrix-widgets/sketch-guess dev",
    "dev:linux": "pnpm --filter @matrix-widgets/linux dev",
    "build": "pnpm typecheck && pnpm -r --if-present build",
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "preview": "pnpm -r --parallel --if-present preview",
    "preview:doodle": "pnpm --filter @matrix-widgets/doodle-phone preview",
    "preview:sketch": "pnpm --filter @matrix-widgets/sketch-guess preview",
    "preview:linux": "pnpm --filter @matrix-widgets/linux preview",
    "lint": "oxlint packages scripts",
    "fmt": "oxfmt packages scripts package.json pnpm-workspace.yaml README.md .github dev",
    "fmt:check": "oxfmt --check packages scripts package.json pnpm-workspace.yaml README.md .github dev",
    "check": "pnpm fmt:check && pnpm lint && pnpm test && pnpm build",
    "assets:linux": "pnpm --filter @matrix-widgets/linux assets",
    "guest:build": "pnpm --filter @matrix-widgets/linux guest:build",
    "release:prepare": "pnpm build && node scripts/prepare-release.mjs",
    "clean": "node scripts/clean.mjs",
    "local:up": "pnpm build && node scripts/local-stack.mjs up",
    "local:down": "node scripts/local-stack.mjs down",
    "local:seed": "node scripts/local-stack.mjs seed",
    "local:logs": "node scripts/local-stack.mjs logs",
    "local:status": "node scripts/local-stack.mjs status",
    "local:check": "node scripts/check-local-stack.mjs"
  },
  "devDependencies": {
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0"
  },
  "engines": {
    "node": ">=22.6.0"
  },
  "packageManager": "pnpm@9.14.4"
}
